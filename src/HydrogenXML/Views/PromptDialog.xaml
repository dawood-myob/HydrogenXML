<Window x:Class="HydrogenXML.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HydrogenXML" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.PanelBg}" Foreground="{DynamicResource App.Fg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="LabelText" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Grid.Row="1" Padding="4,3" />
        <ComboBox x:Name="ValueCombo" Grid.Row="1" IsEditable="True" Padding="4,3" Visibility="Collapsed" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
