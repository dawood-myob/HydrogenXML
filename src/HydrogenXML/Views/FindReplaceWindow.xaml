<Window x:Class="HydrogenXML.Views.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find / Replace" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False"
        Background="{DynamicResource App.PanelBg}" Foreground="{DynamicResource App.Fg}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBox x:Name="FindBox" Grid.Column="1" Padding="4,3" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="Replace:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Padding="4,3" Margin="0,0,0,6" />

        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,8">
            <CheckBox x:Name="MatchCase" Content="Match case" Margin="0,0,14,0" />
            <CheckBox x:Name="WholeWord" Content="Whole word" Margin="0,0,14,0" />
            <CheckBox x:Name="UseRegex" Content="Regular expression" />
        </WrapPanel>

        <WrapPanel Grid.Row="3" Grid.ColumnSpan="2">
            <Button Content="Find next" Click="FindNext_Click" IsDefault="True" Style="{StaticResource MiniButton}" />
            <Button Content="Find previous" Click="FindPrev_Click" Style="{StaticResource MiniButton}" />
            <Button Content="Replace" Click="Replace_Click" Style="{StaticResource MiniButton}" />
            <Button Content="Replace all" Click="ReplaceAll_Click" Style="{StaticResource MiniButton}" />
            <Button Content="Count" Click="Count_Click" Style="{StaticResource MiniButton}" />
        </WrapPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   Foreground="{DynamicResource App.SubtleFg}" TextWrapping="Wrap" />
    </Grid>
</Window>
