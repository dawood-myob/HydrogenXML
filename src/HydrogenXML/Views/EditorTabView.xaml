<UserControl x:Class="HydrogenXML.Views.EditorTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource App.EditorBg}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="EditorStyle" TargetType="avalonedit:TextEditor">
            <Setter Property="Background" Value="{DynamicResource App.EditorBg}" />
            <Setter Property="Foreground" Value="{DynamicResource App.Fg}" />
            <Setter Property="LineNumbersForeground" Value="{DynamicResource App.SubtleFg}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="ShowLineNumbers" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <ContextMenu x:Key="EditorMenu" Opened="Menu_Opened">
            <MenuItem Header="Cut" Click="Cut_Click" InputGestureText="Ctrl+X" />
            <MenuItem Header="Copy" Click="Copy_Click" InputGestureText="Ctrl+C" />
            <MenuItem Header="Paste" Click="Paste_Click" InputGestureText="Ctrl+V" />
            <MenuItem Header="Select all" Click="SelectAll_Click" InputGestureText="Ctrl+A" />
            <Separator />
            <MenuItem Header="Undo" Click="Undo_Click" InputGestureText="Ctrl+Z" />
            <MenuItem Header="Redo" Click="Redo_Click" InputGestureText="Ctrl+Y" />
            <Separator />
            <MenuItem Header="Format document" Click="Format_Click" InputGestureText="Ctrl+Shift+F" />
            <MenuItem Header="Toggle bookmark" Click="Bookmark_Click" InputGestureText="Ctrl+F2" />
            <MenuItem Header="Collapse all nodes" Click="FoldAll_Click" />
            <MenuItem Header="Expand all nodes" Click="UnfoldAll_Click" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource App.Banner}" Padding="8,4"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" Foreground="{DynamicResource App.Fg}" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="SplitterRow" Height="0" />
                <RowDefinition x:Name="SecondRow" Height="0" />
            </Grid.RowDefinitions>

            <avalonedit:TextEditor x:Name="Editor1" Style="{StaticResource EditorStyle}"
                                   ContextMenu="{StaticResource EditorMenu}" />
            <GridSplitter x:Name="Splitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          Style="{StaticResource PaneSplitter}" Visibility="Collapsed" />
            <avalonedit:TextEditor x:Name="Editor2" Grid.Row="2" Style="{StaticResource EditorStyle}"
                                   ContextMenu="{StaticResource EditorMenu}" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
