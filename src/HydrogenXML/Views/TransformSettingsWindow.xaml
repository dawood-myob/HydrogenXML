<Window x:Class="HydrogenXML.Views.TransformSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transformation settings" Width="560" Height="520" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.PanelBg}" Foreground="{DynamicResource App.Fg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Live preview">
            <StackPanel Margin="8">
                <CheckBox x:Name="AutoBox" Content="Transform automatically when the XSL or XML changes" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Delay (ms):" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="DelayBox" IsEditable="True" Width="100" />
                </StackPanel>
                <CheckBox x:Name="PrettyBox" Content="Pretty-print the output" Margin="0,8,0,0" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Entry point (XSLT 2.0 / 3.0)" Grid.Row="1" Margin="0,10,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Initial template:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="TemplateBox" Grid.Column="1" Margin="0,0,0,6" Padding="4,3"
                         ToolTip="Leave empty to apply templates to the source document. Use xsl:initial-template or a named template." />
                <TextBlock Grid.Row="1" Text="Initial mode:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ModeBox" Grid.Row="1" Grid.Column="1" Padding="4,3" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Stylesheet parameters" Grid.Row="2" Margin="0,10,0,0">
            <DataGrid x:Name="ParamGrid" Margin="8" AutoGenerateColumns="False" CanUserAddRows="True"
                      CanUserDeleteRows="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
