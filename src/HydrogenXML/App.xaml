<Application x:Class="HydrogenXML.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PaneSplitter" TargetType="GridSplitter">
                <Setter Property="Background" Value="{DynamicResource App.Splitter}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="ShowsPreview" Value="False" />
            </Style>

            <Style x:Key="PaneToolbar" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource App.HeaderBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="4,2" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
